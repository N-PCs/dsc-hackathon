{
  "name": "dsc-hackathon-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"next,api\" -c \"cyan,magenta\" \"npm --prefix frontend run dev\" \"npm --prefix backend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

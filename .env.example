# ─────────────────────────────────────────────
# Local Development Configuration
# Copy this file to .env and fill in real values
# NEVER commit .env to source control
# ─────────────────────────────────────────────

# Server base URL
APP_URL="http://localhost:3000"
PORT="3000"

# ── Neon PostgreSQL (server-side only) ────────
DATABASE_URL=postgresql://<user>:<password>@<host>/neondb?sslmode=require

# ── Clerk Authentication ───────────────────────
# VITE_ prefix → bundled into the client build (safe: publishable key only)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# No VITE_ prefix → server-side only, never exposed to the browser
CLERK_SECRET_KEY=sk_live_...

# ── ImageKit Storage (server-side only) ────────
# Do NOT add VITE_ prefix — the client never reads these directly
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_PRIVATE_KEY=private_...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-id>

# ── Upstash Redis (server-side only) ───────────
UPSTASH_REDIS_REST_URL=https://<your-db-name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your_upstash_rest_token_here>

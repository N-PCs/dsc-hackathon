{
  "name": "origin-hackathon-backend",
  "version": "2.0.0",
  "description": "Production backend with NeonDB, logging, validation",
  "main": "dist/server.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "vercel-build": "echo 'Backend API serverless build ready'",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1122.0",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/redis": "^1.38.2",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "multer": "^2.2.0",
    "pino": "^9.5.0",
    "pino-pretty": "^12.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@vercel/node": "^5.1.10",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=20.x"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
